{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/accounts.js": {
      "maxDuration": 30
    },
    "api/script-review.js": {
      "maxDuration": 60
    },
    "api/script-export.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
