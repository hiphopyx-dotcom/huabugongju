{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/accounts.js": {
      "maxDuration": 30
    },
    "api/generation.js": {
      "maxDuration": 30
    },
    "api/assets.js": {
      "maxDuration": 30
    },
    "api/quota.js": {
      "maxDuration": 30
    },
    "api/images.js": {
      "maxDuration": 180
    },
    "api/pianchang-video.js": {
      "maxDuration": 120
    },
    "api/account-bridge.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/phone-login", "destination": "/api/account-bridge?action=phone-login" },
    { "source": "/api/whoami", "destination": "/api/account-bridge?action=whoami" },
    { "source": "/api/backup", "destination": "/api/account-bridge?action=backup" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/studio/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/studio/",
      "permanent": false
    }
  ]
}
