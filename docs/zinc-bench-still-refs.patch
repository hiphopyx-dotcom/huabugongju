diff -ruN a/still-preview.css b/still-preview.css
--- a/still-preview.css
+++ b/still-preview.css
@@ -0,0 +1,22 @@
+.still-demo { margin: 0; background: #111; color: #eee; font: 15px/1.45 sans-serif; }
+.still-demo main { max-width: 980px; margin: 0 auto; padding: 28px 20px 64px; }
+.still-demo h1 { font-size: 28px; margin: 0 0 8px; }
+.still-demo .banner { background: #2a2416; border: 1px solid #6d5a2a; border-radius: 12px; padding: 12px 14px; }
+.still-compare { margin: 22px 0; padding: 16px; border: 1px solid #333; border-radius: 16px; background: #1c1c1c; }
+.still-head h3 { margin: 0; font-size: 18px; }
+.still-status, .still-note, .still-footnote { color: #bdbdbd; }
+.still-error { color: #ffb4a8; }
+.still-cols { display: grid; grid-template-columns: 1.4fr .8fr; gap: 16px; align-items: start; }
+.still-refs { display: flex; gap: 10px; flex-wrap: wrap; }
+.still-ref, .still-output { position: relative; margin: 0; width: 150px; }
+.still-ref img, .still-output img, .still-missing { display: block; width: 150px; height: 100px; object-fit: cover; border-radius: 10px; background: #2a2a2a; }
+.still-missing { display: grid; place-items: center; text-align: center; padding: 8px; box-sizing: border-box; }
+.still-index, .still-seq { position: absolute; top: 6px; left: 6px; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; background: #111; color: #fff; display: grid; place-items: center; font-weight: 700; box-shadow: 0 0 0 2px #fff; }
+.still-seq:empty { display: none; }
+.still-ref figcaption, .still-output figcaption { display: grid; margin-top: 6px; }
+.still-ref.is-held img { outline: 2px solid #8a5a3a; }
+.still-compare button { background: #efe7d2; color: #1c1c1c; border: 0; border-radius: 999px; padding: 8px 14px; font: inherit; }
+.byte-check { font-family: ui-monospace, monospace; }
+@media (max-width: 720px) {
+  .still-cols { grid-template-columns: 1fr; }
+}
